  "components": {
    "schemas": {
      "CreateRunRequest": {
        "properties": {
          "scenario": {
            "type": "string",
            "title": "Scenario",
            "default": "heatwave"
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 42
          },
          "ticks": {
            "type": "integer",
            "maximum": 96.0,
            "minimum": 1.0,
            "title": "Ticks",
            "default": 96
          },
          "params": {
            "$ref": "#/components/schemas/ScenarioParams"
          },
          "carry_debt": {
            "type": "boolean",
            "title": "Carry Debt",
            "default": true
          }
        },
        "type": "object",
        "title": "CreateRunRequest"
      },
      "CreateRunResponse": {
        "properties": {
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "status"
        ],
        "title": "CreateRunResponse"
      },
      "DeliveryReceiptRequest": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "dispatched",
              "delivered",
              "failed"
            ],
            "title": "Status"
          },
          "provider_message_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Provider Message Id"
          },
          "error": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DeliveryReceiptRequest"
      },
      "EventVerificationRequest": {
        "properties": {
          "history_kw": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "type": "array",
            "title": "History Kw"
          },
          "observed_kw": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array",
            "title": "Observed Kw"
          },
          "event_start_index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Event Start Index"
          },
          "event_end_index": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Event End Index"
          },
          "committed_reduction_kw": {
            "type": "number",
            "minimum": 0.0,
            "title": "Committed Reduction Kw",
            "default": 0.0
          },
          "method": {
            "type": "string",
            "enum": [
              "high_4_of_5",
              "ten_in_ten"
            ],
            "title": "Method",
            "default": "high_4_of_5"
          },
          "adjustment_intervals": {
            "type": "integer",
            "maximum": 16.0,
            "minimum": 0.0,
            "title": "Adjustment Intervals",
            "default": 4
          }
        },
        "type": "object",
        "required": [
          "history_kw",
          "observed_kw",
          "event_start_index",
          "event_end_index"
        ],
        "title": "EventVerificationRequest"
      },
      "FlexibilityEstimateRequest": {
        "properties": {
          "aggregate_kw": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "type": "array",
            "title": "Aggregate Kw"
          },
          "ambient_c": {
            "items": {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            "type": "array",
            "title": "Ambient C"
          },
          "registered_capacity_kw": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Registered Capacity Kw"
          },
          "setpoint_c": {
            "type": "number",
            "maximum": 35.0,
            "minimum": 15.0,
            "title": "Setpoint C",
            "default": 24.0
          }
        },
        "type": "object",
        "required": [
          "aggregate_kw",
          "ambient_c"
        ],
        "title": "FlexibilityEstimateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InjectRequest": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "heatwave",
              "ev_surge",
              "cloud_cover",
              "dt_fault"
            ],
            "title": "Type"
          },
          "magnitude": {
            "type": "number",
            "maximum": 3.0,
            "minimum": 0.0,
            "title": "Magnitude",
            "default": 0.5
          },
          "from_tick": {
            "anyOf": [
              {
