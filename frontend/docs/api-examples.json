{
  "base_url": "http://localhost:8000",
  "examples": {
    "create_run": {
      "request": {
        "method": "POST",
        "path": "/api/runs",
        "body": {
          "scenario": "heatwave",
          "seed": 42,
          "ticks": 12,
          "params": {
            "ami_penetration": 0.75,
            "connected_device_penetration": 0.35,
            "ev_penetration": 0.18,
            "critical_share": 0.05,
            "essential_share": 0.25,
            "peak_multiplier": 1.6,
            "tariff_rs_per_kwh": 8.5
          },
          "carry_debt": false
        }
      },
      "response": {
        "run_id": "abc123def456",
        "status": "pending"
      }
    },
    "poll_run": {
      "request": {
        "method": "GET",
        "path": "/api/runs/abc123def456"
      },
      "response": {
        "run_id": "abc123def456",
        "scenario": "heatwave",
        "seed": 42,
        "ticks": 12,
        "params": {},
        "status": "ready",
        "error": null,
        "carry_debt": false,
        "opening_debt_households": 0,
        "persisted": true,
        "persistence_error": null,
        "generation": 0,
        "injections": [],
        "created_at": "2026-07-31T10:30:00+00:00"
      }
    },
    "inject_heatwave": {
      "request": {
        "method": "POST",
        "path": "/api/runs/abc123def456/inject",
        "body": {
          "type": "heatwave",
          "magnitude": 0.6,
          "from_tick": 4,
          "dt_id": null
        }
      },
      "response": {
        "run_id": "abc123def456",
        "status": "pending",
        "injections": [
          {
            "type": "heatwave",
            "magnitude": 0.6,
            "from_tick": 4,
            "dt_id": null
          }
        ],
        "resimulating_from_tick": 4
      }
    },
    "inject_transformer_fault": {
      "request": {
        "method": "POST",
        "path": "/api/runs/abc123def456/inject",
        "body": {
          "type": "dt_fault",
          "magnitude": 1,
          "from_tick": 6,
          "dt_id": "F1-DT03"
        }
      }
    },
    "estimate_weather_opportunity": {
      "request": {
        "method": "POST",
        "path": "/api/observability/flexibility/estimate",
        "body": {
          "aggregate_kw": [
            [8, 8, 9, 11, 15, 17, 13, 9],
            [8, 8, 10, 13, 17, 19, 15, 10],
            [8, 9, 11, 15, 19, 21, 17, 11],
            [9, 10, 13, 17, 21, 23, 19, 13],
            [10, 11, 15, 19, 23, 25, 21, 15],
            [11, 13, 17, 21, 25, 27, 23, 17],
            [13, 15, 19, 23, 27, 29, 25, 19]
          ],
          "ambient_c": [
            [21, 22, 24, 27, 30, 32, 28, 24],
            [22, 23, 25, 28, 31, 33, 29, 25],
            [23, 24, 26, 29, 32, 34, 30, 26],
            [24, 25, 27, 30, 33, 35, 31, 27],
            [25, 26, 28, 31, 34, 36, 32, 28],
            [26, 27, 29, 32, 35, 37, 33, 29],
            [27, 28, 30, 33, 36, 38, 34, 30]
          ],
