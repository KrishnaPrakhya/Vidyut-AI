      "response_shape": {
        "ready": true,
        "reasons": [],
        "estimated_profile_kw": "array<number>",
        "actionable_profile_kw": "array<number>",
        "estimated_average_kw": "number",
        "estimated_peak_kw": "number",
        "estimated_aggregate_share": "number",
        "actionable_average_kw": "number",
        "actionable_peak_kw": "number",
        "registered_capacity_kw": 5,
        "confidence": "low | medium | high",
        "coverage_pct": 100,
        "temperature_span_c": 17,
        "fit_score": "number",
        "source": "estimated",
        "method": "interval_baseline_temperature_association_v1"
      }
    },
    "verify_event": {
      "request": {
        "method": "POST",
        "path": "/api/observability/events/verify",
        "body": {
          "history_kw": [
            [100, 100, 100, 100, 100, 100, 100, 100],
            [110, 110, 110, 110, 110, 110, 110, 110],
            [120, 120, 120, 120, 120, 120, 120, 120],
            [130, 130, 130, 130, 130, 130, 130, 130],
            [140, 140, 140, 140, 140, 140, 140, 140]
          ],
          "observed_kw": [125, 125, 125, 125, 105, 105, 125, 125],
