        "baseline_average_kw": 125,
        "observed_average_kw": 105,
        "gross_difference_kw": 20,
        "realised_reduction_kw": 20,
        "realised_reduction_kwh": 10,
        "committed_reduction_kw": 20,
        "performance_pct": 100,
        "same_day_adjustment_kw": 0,
        "coverage_pct": 100,
        "confidence": "high",
        "source": "verified"
      }
    },
    "event_query": {
      "request": {
        "method": "GET",
        "path": "/api/runs/abc123def456/events?arm=vidyut&tier=2&dt_id=F1-DT03&offset=0&limit=100"
      }
    },
    "recording_catalog": {
      "request": {
        "method": "GET",
        "path": "/api/recordings"
      },
      "response": {
        "recordings": [
          {
            "scenario": "heatwave",
            "seed": 42,
            "ticks": 96,
            "schema_version": 2,
            "path": "/api/recordings/heatwave?seed=42"
          }
        ]
      }
    },
    "recorded_replay": {
      "request": {
        "method": "GET",
        "path": "/api/recordings/heatwave?seed=42"
      },
      "response_shape": {
        "meta": "Recording metadata and simulated provenance",
        "ticks": "96 synchronized baseline and Vidyut TickFrame objects",
        "summary": "Final RunTotals for both arms and deltas",
        "notifications": "Recorded notification objects"
      }
    },
    "delivery_receipt": {
      "request": {
        "method": "POST",
        "path": "/api/notifications/123/delivery",
        "body": {
          "status": "delivered",
          "provider_message_id": "provider-message-789",
          "error": null
        }
      },
      "warning": "Provider integration callback, not a normal browser UI action."
    },
    "websocket": {
      "connection": "ws://localhost:8000/ws/runs/abc123def456?speed=4&from_tick=0",
      "status_message": {
        "type": "status",
        "status": "running"
      },
      "ready_message": {
        "type": "ready",
        "run_id": "abc123def456",
        "scenario": "heatwave",
        "seed": 42,
        "ticks": 12,
        "injections": []
      },
      "tick_message_shape": {
        "type": "tick",
        "t": 0,
        "clock": "00:00",
        "arms": {
          "baseline": "ArmSnapshot",
          "vidyut": "ArmSnapshot"
        },
        "forecast": "ForecastSnapshot|null"
      },
      "complete_message_shape": {
        "type": "complete",
        "arms": {
          "baseline": "RunTotals",
          "vidyut": "RunTotals"
        },
        "deltas": "Record<string, number>"
      }
    }
  }
}
