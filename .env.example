# Public browser/API origins
CORS_ORIGINS=http://localhost:3000
VIDYUT_PUBLIC_API_URL=http://localhost:8000

# Required for durable run history and n8n delivery callbacks when the API is
# launched directly on Windows. Docker Compose injects its own container URL.
DATABASE_URL=postgresql+psycopg://vidyut:vidyut@localhost:5433/vidyut

# n8n production webhook and two independent shared secrets
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_CALLBACK_TOKEN=

# Docker Compose uses these container-safe addresses. Override the webhook
# value only when your n8n workflow has a different host or path.
N8N_DOCKER_WEBHOOK_URL=http://host.docker.internal:5678/webhook/vidyut-operator-digest
VIDYUT_N8N_API_URL=http://host.docker.internal:8000
