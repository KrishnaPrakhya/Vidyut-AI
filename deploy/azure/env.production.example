# Public DNS names. Create A records for both names pointing to the Azure VM.
API_DOMAIN=api.example.com
N8N_DOMAIN=ops.example.com
FRONTEND_ORIGIN=https://app.example.com
TLS_EMAIL=operator@example.com

# PostgreSQL is private to the Docker network. Use a long hexadecimal value.
POSTGRES_DB=vidyut
POSTGRES_USER=vidyut
POSTGRES_PASSWORD=CHANGE_ME_64_HEX_CHARACTERS

# n8n encryption and the two independent Vidyut authentication directions.
N8N_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS
N8N_WEBHOOK_TOKEN=CHANGE_ME_64_HEX_CHARACTERS
N8N_CALLBACK_TOKEN=CHANGE_ME_DIFFERENT_64_HEX_CHARACTERS

# Appears in persisted run metadata and reports.
VIDYUT_SIM_VERSION=production
